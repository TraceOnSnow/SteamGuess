# Server-side only. Never prefix this with VITE_ and never commit the real key.
# Used by the local /api/steam-library development endpoint.
STEAM_WEB_API_KEY=

# Optional production backend endpoint implementing the same JSON contract.
# VITE_STEAM_LIBRARY_API_URL=https://example.com/api/steam-library

# Runtime SQLite database used by the production/dev API.
# Defaults to data/runtime/steamguess.sqlite
STEAMGUESS_DB_PATH=

# Persistent catalog and internal difficulty management. The token is required
# by production admin writes; the Vite development server permits local access.
STEAMGUESS_CATALOG_DB_PATH=data/catalog/catalog.sqlite
STEAMGUESS_ADMIN_TOKEN=
STEAMGUESS_BACKUP_DIR=data/backups
STEAMGUESS_BACKUP_KEEP=14

# Production HTTP server
PORT=4173
HOST=0.0.0.0

# Internal difficulty manager UI. Keep false on public deployments.
VITE_LABELER_ENABLED=false

# Trust X-Forwarded-For only when running behind your own reverse proxy.
STEAMGUESS_TRUST_PROXY=false
STEAMGUESS_WRITE_RATE_LIMIT=60
STEAMGUESS_PROFILE_RATE_LIMIT=12
STEAMGUESS_REQUEST_LOG=false

# Multiplayer. Without these variables, rooms use the single-process memory
# fallback. Set both for multiple Node processes on the same host.
# Socket.IO is served from the same HOST/PORT at /socket.io using WebSocket.
# Optional explicit value: memory or redis. Leaving it empty selects Redis when
# STEAMGUESS_REDIS_URL is set, otherwise the memory fallback.
STEAMGUESS_ROOM_STORE=
STEAMGUESS_REDIS_URL=
# Change the prefix when multiple independent SteamGuess deployments share Redis.
STEAMGUESS_REDIS_PREFIX=steamguess:multiplayer

# Catalog publication and internal difficulty administration
STEAMGUESS_CATALOG_PATH=data/catalog/steamspy_candidates.json
# Historical variable name: this file is now the Search runtime snapshot.
# Rows carrying a valid difficulty form the smaller Playable answer pool.
STEAMGUESS_PLAYABLE_PATH=public/games_demo.json
STEAMGUESS_ACTIVE_LIMIT=1000
STEAMGUESS_DETAIL_LIMIT=4000
# Backward-compatible variable name. This is the minimum published Search
# catalog size checked during deployment, not the scored answer-pool size.
STEAMGUESS_MIN_PLAYABLE_GAMES=500

# Player-feedback difficulty synchronization (offline batch)
STEAMGUESS_FEEDBACK_MIN_SAMPLES=10
STEAMGUESS_FEEDBACK_PRIOR_WEIGHT=20
STEAMGUESS_FEEDBACK_MAX_DELTA=3
STEAMGUESS_FEEDBACK_MAX_STDDEV=20

# Optional AI review redaction. Raw reviews remain unchanged; successful,
# hash-matching output is imported into the catalog SQLite sidecar table.
STEAMGUESS_REDACTION_MODEL=
STEAMGUESS_REDACTION_SCOPE=detail
STEAMGUESS_REDACTION_REVIEWS_PER_LANGUAGE=100
STEAMGUESS_REDACTION_DELAY=2
STEAMGUESS_REDACTION_TIMEOUT=120
STEAMGUESS_REDACTION_RETRIES=3
STEAMGUESS_REDACTION_RETRY_DELAY=10
STEAMGUESS_REDACTION_IMPORT_DB=data/catalog/catalog.sqlite
