# Every variable is optional; the defaults run a single-process server.

# HTTP server
PORT=4173
HOST=0.0.0.0

# Runtime SQLite database (players, finished rounds, verdicts, match history).
# Defaults to data/runtime/steamguess.sqlite
STEAMGUESS_DB_PATH=
STEAMGUESS_BACKUP_DIR=data/backups
STEAMGUESS_BACKUP_KEEP=14

# Trust X-Forwarded-For only when running behind your own reverse proxy.
STEAMGUESS_TRUST_PROXY=false
# POST requests allowed per client address per minute.
STEAMGUESS_WRITE_RATE_LIMIT=60
STEAMGUESS_REQUEST_LOG=false

# Multiplayer rooms live in memory by default. Set a Redis URL to share rooms
# between several Node processes; STEAMGUESS_ROOM_STORE may force memory or redis.
STEAMGUESS_ROOM_STORE=
STEAMGUESS_REDIS_URL=
# Change the prefix when several independent deployments share one Redis.
STEAMGUESS_REDIS_PREFIX=steamguess:multiplayer
