{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steamguess.local/schema/game-catalog.schema.json",
  "title": "SteamGuess game catalog",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "games"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "model": { "type": "object" },
    "stats": { "type": "object" },
    "games": {
      "type": "array",
      "items": { "$ref": "#/$defs/game" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["service", "endpoint", "retrievedAt"],
      "properties": {
        "service": { "enum": ["steamspy", "pics", "storefront", "manual"] },
        "endpoint": { "type": "string" },
        "retrievedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "game": {
      "type": "object",
      "required": ["appId", "name", "metrics", "recognition", "difficulty", "sources", "fieldSources"],
      "properties": {
        "appId": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": ["string", "null"] },
        "releaseDate": { "type": ["string", "null"] },
        "developers": { "type": "array", "items": { "type": "string" } },
        "publishers": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "object" } },
        "metrics": {
          "type": "object",
          "required": ["ccu", "ownersMin", "ownersMax", "positive", "negative", "reviewsTotal"],
          "properties": {
            "ccu": { "type": "integer", "minimum": 0 },
            "ownersMin": { "type": "integer", "minimum": 0 },
            "ownersMax": { "type": "integer", "minimum": 0 },
            "positive": { "type": "integer", "minimum": 0 },
            "negative": { "type": "integer", "minimum": 0 },
            "reviewsTotal": { "type": "integer", "minimum": 0 },
            "averageForeverMinutes": { "type": "integer", "minimum": 0 },
            "averageTwoWeeksMinutes": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "recognition": {
          "type": "object",
          "required": ["score", "features"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 100 },
            "features": { "type": "object" }
          }
        },
        "difficulty": {
          "type": "object",
          "required": ["score", "level", "source", "excluded"],
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 100 },
            "level": { "enum": ["easy", "normal", "hard", "hell"] },
            "source": { "enum": ["heuristic", "regression", "manual"] },
            "excluded": { "type": "boolean" },
            "manualLevel": { "type": ["string", "null"], "enum": ["easy", "normal", "hard", "hell", null] }
          }
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "fieldSources": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
